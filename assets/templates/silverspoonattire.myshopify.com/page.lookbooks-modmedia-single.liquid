<div class="sixteen columns clearfix collection_nav">
  <h1 class="collection_title">
    {{ page.title }}
  </h1>
</div>

<div class="sixteen columns page">
    <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div>            
            {{ page.content }}
</div>
<script type="text/javascript">
var modlookbook_exist=false;
  var modlookbook_url = 'http://shopifyexpert.com.au/lookbook/assets/templates/silverspoonattire.myshopify.com/mod_media_lightbox_3e663{{ page.id }}.js?t=1398285387';
    var modlookbook_scripts = document.getElementsByTagName('script');
    for (var i = modlookbook_scripts.length; i--;) {
      if (modlookbook_scripts[i].src == modlookbook_url){
        modlookbook_exist=true;
      };
    }
  if(!modlookbook_exist){
    Shopify.money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "http://shopifyexpert.com.au/lookbook/assets/templates/silverspoonattire.myshopify.com/mod_media_lightbox_3e663{{ page.id }}.js?t=1398285387";
    document.getElementsByTagName("head")[0].appendChild(s);
    }
</script>
</div>