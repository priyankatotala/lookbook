{% if settings.products_featured_collection != blank %}
  {% if collections[settings.products_featured_collection].products_count != 0 %}
    {% assign sidebar_enable = true %}
  {% endif %}
{% endif %}

<h1 class="small--text-center">{{ page.title }}</h1>

<div class="grid">
  <div class="grid__item{% if sidebar_enable %} medium-up--three-quarters large-up--four-fifths{% endif %}">
    <div class="content-block content-block--large">
      <div class="rte rte--indented-images">
        <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div><div class='lookbook-spe-content'>{{ page.content }}</div>{{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
    var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://shopifyexpert.com.au/lookbook/assets/templates/kohn-kartel.myshopify.com/mod_media_lightbox_d6c7f{{page.id}}.js?t=1477872720";
    document.getElementsByTagName("head")[0].appendChild(s);
</script>
        {% include 'lookbooks-app' %}
      </div>
    </div>
  </div>
  {% if sidebar_enable %}
    <div class="grid__item medium-up--one-quarter large-up--one-fifth small--hide">
      {% include 'featured-products' %}
    </div>
  {% endif %}
</div>
