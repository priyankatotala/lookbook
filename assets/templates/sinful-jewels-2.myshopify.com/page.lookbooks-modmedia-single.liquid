	<div class="tp-banner-container">
		<div class="tp-banner" >
			<ul>
              
    {% for i in (1..10) %}
        {% capture show_slide %}display_lookbook_{{ i }}{% endcapture %}    
    {% capture image %}lookbook_{{ i }}.jpg{% endcapture %}
    {% capture link %}lookbook_{{ i }}_link{% endcapture %}
    {% capture alt %}lookbook_{{ i }}_alt{% endcapture %}
    {% if settings[show_slide] %}
      {% if settings[link] != blank %}
      	<a href="{{ settings[link] }}">
      {%endif%}  
				<li data-transition="random" data-slotamount="7" data-masterspeed="1500" >
					<img src="{{ image | asset_url }}"  alt="{{ settings[alt] | escape }}"  data-bgfit="cover" data-bgposition="center top" data-bgrepeat="no-repeat">
				</li>
      {% if settings[link] != blank %}
        </a>
      {% endif %}
        {% endif %}
        {% endfor %}              
              
			</ul>
		</div>
	</div>      

  
  
