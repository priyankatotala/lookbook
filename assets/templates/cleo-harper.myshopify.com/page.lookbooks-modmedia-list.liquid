<div class="section-title desktop-12 mobile-3">
  <h1>{{ page.title }}</h1>
</div>

<div class="{% if settings.pagelist == '' %}desktop-12 tablet-6 mobile-3{% else %}desktop-9 tablet-4 mobile-3{% endif %}">
  <div class="rte">
    <div id="modmedia-lookbooks" class="list">
            <div id="lookbook-modmedia-container">
            Loading...
            </div>
</div><div class='lookbook-spe-content'>{{ page.content }}</div>{{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
<script type="text/javascript">
var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
var pages_content = {'skyhigh':{{ pages.skyhigh.content | json }},'ethereal':{{ pages.ethereal.content | json }},'sg-x-cleo-harper-1':{{ pages.sg-x-cleo-harper-1.content | json }},'palm-springs':{{ pages.palm-springs.content | json }},'live-lounge':{{ pages.live-lounge.content | json }},'artistry-2019':{{ pages.artistry-2019.content | json }},'sg-x-cleo-harper':{{ pages.sg-x-cleo-harper.content | json }},'earth-2018':{{ pages.earth-2018.content | json }},'cleo-harper-azure':{{ pages.cleo-harper-azure.content | json }},'classic-vi-2018':{{ pages.classic-vi-2018.content | json }},'haze-2017':{{ pages.haze-2017.content | json }},'french-riviera-2017':{{ pages.french-riviera-2017.content | json }},'precious-stones-2017':{{ pages.precious-stones-2017.content | json }},'monochrome-luxe-2017':{{ pages.monochrome-luxe-2017.content | json }}};
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://modapps2.com.au/lookbook/assets/templates/cleo-harper.myshopify.com/mod_media_lightbox_list_ccbd0.js?t=1578812775";
    document.getElementsByTagName("head")[0].appendChild(s);
</script>
  </div>
</div>

{% if settings.pagelist != '' %}
  <div id="page-sidebar" class="desktop-3 tablet-2 mobile-3">
    <h2>{{ settings.page-sidebar-title }}</h2>
    <ul>
      {% for link in linklists[settings.pagelist].links %}
        <li>{{ link.title | link_to: link.url }}</li>
      {% endfor %}
    </ul>

    {% if settings.pagelist == '' %}
      <p>You are seeing this message as you have yet to pick a linklist in the Pages and contact form section of the theme settings</p>
      <p>In your admin click on Themes > Customize Theme > Pages and Contact form and choose a Linklist from the dropdown in the area marked Choose a linklist for page sidebar</p>
    {% endif %}

  </div>
{% endif %}
