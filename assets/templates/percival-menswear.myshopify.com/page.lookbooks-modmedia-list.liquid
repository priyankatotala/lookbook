<script type="text/javascript">
var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
var pages_content = {'test':{{ pages.test.content | json }},'limited-edition-knitwear':{{ pages.limited-edition-knitwear.content | json }},'1-of-30-made-in-london':{{ pages.1-of-30-made-in-london.content | json }},'japanese-shirting':{{ pages.japanese-shirting.content | json }},'spring-17-a-treviso-vintage':{{ pages.spring-17-a-treviso-vintage.content | json }},'lookbook-carousel':{{ pages.lookbook-carousel.content | json }},'shirting-carousel':{{ pages.shirting-carousel.content | json }},'shirt-carousel':{{ pages.shirt-carousel.content | json }},'summer-lookbook':{{ pages.summer-lookbook.content | json }},'shirting-carousel-2':{{ pages.shirting-carousel-2.content | json }},'pre-fall-17-outerwear':{{ pages.pre-fall-17-outerwear.content | json }},'outerwear-carousel':{{ pages.outerwear-carousel.content | json }},'the-tama-collection':{{ pages.the-tama-collection.content | json }},'coffee-in-soho':{{ pages.coffee-in-soho.content | json }},'winter-2017-part-i':{{ pages.winter-2017-part-i.content | json }},'japanese-spring-shirts':{{ pages.japanese-spring-shirts.content | json }},'the-okinawa-exchange':{{ pages.the-okinawa-exchange.content | json }},'holiday-from-home':{{ pages.holiday-from-home.content | json }},'summer-18-part-i':{{ pages.summer-18-part-i.content | json }},'perci-x-halloween':{{ pages.perci-x-halloween.content | json }}};
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://modapps2.com.au/lookbook/assets/templates/percival-menswear.myshopify.com/mod_media_lightbox_list_20709.js?t=1592926740";
