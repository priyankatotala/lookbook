<section class="collection-heading heading-content ">
  {% if settings.banner_breadcrumb_page %}
  <a href="{{ settings.banner_breadcrumb_page_link }}">
    <img class="img_heading" src="{{ settings.banner_breadcrumb_page | img_url: '', crop: '' }}" alt="{{ settings.banner_breadcrumb_page.alt }}" />
  </a>
  {% endif %}
  <div class="container">
    <div class="row">
      <div class="collection-wrapper">
        <h1 class="collection-title"><span>{{ page.title }}</span></h1>     
        <div class="breadcrumb-group">
          <div class="breadcrumb clearfix">
            <span itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
              <a href="{{ shop.url }}" title="{{ shop.name | escape }}" itemprop="url"><span itemprop="title">{{ 'general.breadcrumbs.home' | t }}</span></a></span>
            <span class="arrow-space">&#62;</span>
            <span itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
              <a href="{{ page.url }}" title="{{ page.title }}" itemprop="url"><span itemprop="title">{{ page.title }}</span></a>
            </span>              
          </div>         
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page-content page-lookbook">
  <div class="page-wrapper">
    <div class="container">
      <div class="row">
        <div class="page-inner">
          {% if page.content != '' %}
          <div id="page" class="row">
            <div class="details">              
              <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div><div class='lookbook-spe-content'>{{ page.content }}</div>{{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
    var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://shopifyexpert.com.au/lookbook/assets/templates/tnvcollection.myshopify.com/mod_media_lightbox_52c0c{{page.id}}.js?t=1533562973";
    document.getElementsByTagName("head")[0].appendChild(s);
</script>
            </div>
          </div>
          {% endif %}
          {% section 'lookbook-template' %}
        </div>
      </div>
    </div>
  </div>
</section>