<div class="container cf">
  <div class="page-header cf">
<h1 class="majortitle">{{ page.title }}</h1>    
    <div class="social-area">{% include 'social-sharing' %}</div>
  </div>
  <div class="user-content row-spacing {% if settings.lightbox_imgs %}lightboximages{% endif %}">
    <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div>            
            {{ page.content }}
</div>
<script type="text/javascript">
var modlookbook_exist=false;
  var modlookbook_url = 'http://shopifyexpert.com.au/lookbook/assets/templates/leeljewelry.myshopify.com/mod_media_lightbox_643a0{{ page.id }}.js?t=1397001543';
    var modlookbook_scripts = document.getElementsByTagName('script');
    for (var i = modlookbook_scripts.length; i--;) {
      if (modlookbook_scripts[i].src == modlookbook_url){
        modlookbook_exist=true;
      };
    }
  if(!modlookbook_exist){
    Shopify.money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "http://shopifyexpert.com.au/lookbook/assets/templates/leeljewelry.myshopify.com/mod_media_lightbox_643a0{{ page.id }}.js?t=1397001543";
    document.getElementsByTagName("head")[0].appendChild(s);
    }
</script>
  </div>
</div>