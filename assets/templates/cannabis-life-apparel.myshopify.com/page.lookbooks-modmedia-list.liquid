    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://shopifyexpert.com.au/lookbook/assets/templates/cannabis-life-apparel.myshopify.com/mod_media_lightbox_list_c1fce.js?t=1516046075";
    document.getElementsByTagName("head")[0].appendChild(s);
</script></div>