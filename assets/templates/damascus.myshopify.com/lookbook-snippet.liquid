<header class="page__header">
  {% include 'breadcrumb' %}

  <div class="page__header-wrapper">
    <div class="container">
      <h1 class="page__title">{{ page.title }}</h1>
    </div>
  </div>
</header>

<section class="page__content">
  <div class="slider__cover-wrapper">
    <div class="rte">
      <div id="modmedia-lookbooks" class="list">
            <div id="lookbook-modmedia-container">
            </div>
            {{ page.lookbooks.content }}
                {{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
var pages_content = {'damascus-x-pksound-collaboration':{{ pages.damascus-x-pksound-collaboration.content | json }},'dthwlvs':{{ pages.dthwlvs.content | json }},'damascus-x-palehorse-samsara':{{ pages.damascus-x-palehorse-samsara.content | json }}};
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "http//shopifyexpert.com.au/lookbook/assets/templates/damascus.myshopify.com/mod_media_lightbox_list_a0f82.js?t=1506051999";
    document.getElementsByTagName("head")[0].appendChild(s);
                </script>
    </div>
  </div>
</section>
