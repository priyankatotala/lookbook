    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "http//shopifyexpert.com.au/lookbook/assets/templates/jennifer-zeuner-jewelry.myshopify.com/mod_media_lightbox_list_7f44b.js?t=1533324950";
    document.getElementsByTagName("head")[0].appendChild(s);
