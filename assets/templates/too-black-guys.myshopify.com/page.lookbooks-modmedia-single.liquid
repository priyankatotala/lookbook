{% if page.handle == 'contact' %}
  <div class="row page-title p25">
    <div class="container cms">
      <h1 class="p25 span6 inner-left">{{ page.title }}</h1>
      <div class="span6 contact-cont inner-left inner-right">
        <ul>
          <li class=""><span>Brand Inquiries</span><a href="mailto:INFO@TOOBLACKGUYS.CO">INFO@TOOBLACKGUYS.CO</a></li>
          <li class=""><span>Online Order Inquiries</span><a href="mailto:CUSTOMERSERVICE@TOOBLACKGUYS.CO">CUSTOMERSERVICE@TOOBLACKGUYS.CO</a></li>
          <li class=""><span>Media Inquiries</span><a href="mailto:MELISSA@TOOBLACKGUYS.CO">MELISSA@TOOBLACKGUYS.CO</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container cms">
    <div id="page" class="row">
      <div class="details">
        <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div><div class='lookbook-spe-content'>{{ page.content }}</div>{{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
    var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://modapps2.com.au/lookbook/assets/templates/too-black-guys.myshopify.com/mod_media_lightbox_de1bc{{page.id}}.js?t=1552956802";
    document.getElementsByTagName("head")[0].appendChild(s);
</script>
      </div>
    </div>
  </div>
{% else %}
  <div class="row page-title p25">

    <div class="container cms">
      <h1 class="p25">{{ page.title }}</h1>
    </div>
  </div>
  <div class="container cms">
    <div id="page" class="row">
      <div class="details">
        <div id="modmedia-lookbooks" class="single">
            <div id="lookbook-modmedia-container">
            </div><div class='lookbook-spe-content'>{{ page.content }}</div>{{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
    var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://modapps2.com.au/lookbook/assets/templates/too-black-guys.myshopify.com/mod_media_lightbox_de1bc{{page.id}}.js?t=1552956802";
    document.getElementsByTagName("head")[0].appendChild(s);
</script>
      </div>
    </div>
  </div>
{% endif %}