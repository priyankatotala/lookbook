<div id="page" class="row">

  <div class="span12 details">
    {% assign showContent = true %}
    {% if page.handle == 'our-inspiration' %}
      {% assign showContent = false %}
    	{% include 'our-inspiration' %}
    {% endif %}
    {% if page.handle == 'our-story' %}
      {% assign showContent = false %}
    	{% include 'our-story' %}
    {% endif %}
    {% if page.handle == 'privacy-policy' or page.handle == 'faqs' %}
      {% assign showContent = false %}
	    {% include 'customer-care' %}
    {% endif %}
    {% if page.handle == 'shipping-returns' or page.handle == 'terms-of-use' %}
      {% assign showContent = false %}
	    {% include 'customer-care' %}
    {% endif %}

    {% if showContent != false %}
      <div class="wblp_page_content">
        <div id="modmedia-lookbooks" class="list">
            <div id="lookbook-modmedia-container">
            </div>
            {{ page.lookbooks.content }}
                {{ 'lookbooks-modmedia-styles.css' | asset_url | stylesheet_tag }}
{{ 'lookbooks-modmedia-scripts.js' | asset_url | script_tag }}
</div>
<script type="text/javascript">
var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
var pages_content = {'cruise-2015-lookbook':{{ pages.cruise-2015-lookbook.content | json }}};
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "//shopifyexpert.com.au/lookbook/assets/templates/helen-jon-2.myshopify.com/mod_media_lightbox_list_b970d.js?t=1449689165";
    document.getElementsByTagName("head")[0].appendChild(s);
                </script>
      </div>
    {% endif %}
  </div>

</div>
