    var modlookbook_money_with_currency_format = "{{ shop.money_with_currency_format }}";
    var s = document.createElement("script");
    s.type = "text/javascript";
    s.src = "https://shopifyexpert.com.au/lookbook/assets/templates/active-fit.myshopify.com/mod_media_lightbox_7ae4e{{page.id}}.js?t=1533130817";
